<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>Motif.Bubbles.App</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motif.Bubbles\Motif.Bubbles.UseCases\Motif.Bubbles.UseCases.csproj" />
    <!-- The Web App is the composition root, so it alone knows the real adapters. -->
    <ProjectReference Include="..\Adapters\Motif.Bubbles.ForOpeningRepos\Motif.Bubbles.ForOpeningRepos.csproj" />
    <ProjectReference Include="..\Adapters\Motif.Bubbles.ForOpeningFolders\Motif.Bubbles.ForOpeningFolders.csproj" />
  </ItemGroup>

</Project>

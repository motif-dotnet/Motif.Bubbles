@namespace Motif.Bubbles.App
@implements IDisposable

<PageTitle>@PageTitle</PageTitle>

@if (started)
{
<div class="app @(dragDepth > 0 ? "dragging" : "")" @onclick="CloseMenus"
     @ondragenter="DragEnter" @ondragleave="DragLeave" @ondragover:preventDefault="true" @ondrop="Drop" @ondrop:preventDefault="true">
    <header class="appbar @(Drawn ? "drawn" : "")">
        <ToolSwitcher Current="bubbles" Repo="@Queries.Repo" Open="@(menu == Menu.Tools)" OnToggle="@(() => Toggle(Menu.Tools))" />

        @if (Queries.Source is { Kind: not SourceKind.None } source)
        {
            <div class="vsep wide"></div>
            <span class="pill" title="@source.About">@SourceIcon(source.Kind)<span class="text">@source.Name</span></span>
            @if (source.Report != "")
            {
                <span class="pill report wide" title="Where the mutation rings came from">@Icons.Report<span class="text">@source.Report</span></span>
            }
        }

        <div class="spacer"></div>

        @if (Drawn)
        {
            <button class="cmd" title="Back to the ways in" @onclick="StartAgain">@Icons.Back<span class="wide">Start again</span></button>
            <div class="vsep way-in"></div>
        }
        <button class="cmd way-in" title="Open a Motif repo's folder, or drop one anywhere" @onclick="OpenFolder">@Icons.Folder<span class="wide">Open</span></button>
        <button class="cmd way-in" title="Draw a public GitHub repo" @onclick="ShowRepo">@Icons.Repo<span class="wide">Repo</span></button>
        <div class="vsep"></div>
        <ThemeMenu Theme="@theme" ThemeChanged="SetTheme" Open="@(menu == Menu.Theme)" OnToggle="@(() => Toggle(Menu.Theme))" />
        <button class="cmd icon" title="Help" @onclick="ToggleHelp" @onclick:stopPropagation="true">@SuiteIcons.Help</button>
    </header>

    @if (Queries.Loading)
    {
        <div class="progress" role="status" aria-label="Reading the repo"></div>
    }
    @if (Drawn && Queries.RingsNote is var note && note != Note.None)
    {
        <div class="banner"><span><b>@note.Title.</b> @note.Text</span></div>
    }

    @if (Drawn)
    {
        <GraphView Seeing="Queries" Tasks="Tasks" RepoLink="@RepoLinkUrl" CopyRepoLink="CopyRepoLink" Copied="copied" />
    }
    else if (!Queries.Loading)
    {
        <main class="scroll">
            <section class="start">
                <h1>See a Motif app's architecture as bubbles</h1>
                <p class="lead">Every part of the app in its place in ports and adapters, sized by its lines of code, linked to what it uses, implements and checks, and ringed with how many of Stryker's mutants its specs catch.</p>
                <div class="ways">
                    <button class="way" @onclick="OpenFolder">
                        @Icons.Folder
                        <b>Open or drop a folder</b>
                        <span>A Motif repo's root folder, the one with its <code>.sln</code>. Rings come from the latest report in its <code>StrykerOutput/</code>. Drop it anywhere on the page.</span>
                    </button>
                    <div class="way repo">
                        @Icons.Repo
                        <b>A public GitHub repo</b>
                        <span>Reads the code on the default branch, with rings from the Stryker report its CI publishes to its Pages site.</span>
                        <form class="repo-form" @onsubmit="SubmitRepo" @onsubmit:preventDefault="true">
                            <input id="start-repo" placeholder="owner/name" aria-label="GitHub repo, as owner/name" @bind="repoText" @bind:event="oninput" spellcheck="false" autocapitalize="off" />
                            <button class="primary" type="submit" disabled="@(string.IsNullOrWhiteSpace(repoText))">Draw</button>
                        </form>
                        <span class="help">Such as <button type="button" class="linkish" @onclick="@(() => repoText = "motif-dotnet/Motif.Glossary")">motif-dotnet/Motif.Glossary</button>.</span>
                    </div>
                </div>
                <p class="muted small">Everything happens in this browser: nothing is uploaded, and there's no sign-in. Visits are counted, with no cookies, by <a href="https://www.goatcounter.com" target="_blank" rel="noopener">GoatCounter</a>. Part of <a href="https://github.com/motif-dotnet" target="_blank" rel="noopener">Motif.NET</a>.</p>
            </section>
        </main>
    }

    @if (dragDepth > 0)
    {
        <div class="drop-overlay" aria-hidden="true"><div>Drop a Motif repo's folder</div></div>
    }

    @if (dialog == Dialog.Repo)
    {
        <div class="scrim" @onclick="CloseDialog">
            <div class="card dialog" role="dialog" aria-label="Draw a GitHub repo" @onclick:stopPropagation="true">
                <header><div class="t"><b>Draw a GitHub repo</b><span>A public Motif repo, from its default branch</span></div><button class="x" title="Close" @onclick="CloseDialog">@SuiteIcons.Close</button></header>
                <div class="body">
                    <form @onsubmit="SubmitRepo" @onsubmit:preventDefault="true">
                        <div class="field"><label for="repo-box">Repo</label><input id="repo-box" placeholder="owner/name" @bind="repoText" @bind:event="oninput" spellcheck="false" autocapitalize="off" /></div>
                        <p class="help">Such as <button type="button" class="linkish" @onclick="@(() => repoText = "motif-dotnet/Motif.Glossary")">motif-dotnet/Motif.Glossary</button>. A github.com address works too.</p>
                        <div class="row end"><button type="button" class="ghost" @onclick="CloseDialog">Cancel</button><button type="submit" class="primary" disabled="@string.IsNullOrWhiteSpace(repoText)">Draw</button></div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (helpOpen)
    {
        <HelpDialog Current="bubbles" OnClose="@(() => helpOpen = false)">
            <h4>Ways in</h4>
            <ul>
                <li><b>Open</b> or drop a Motif repo's root folder. Rings come from the latest Stryker JSON report in its <code>StrykerOutput/</code>.</li>
                <li><b>Repo</b> reads a public GitHub repo's default branch, with rings from <code>motif/mutation-report.json</code> on its Pages site. The address then links straight to its bubbles.</li>
            </ul>
            <h4>The bubbles</h4>
            <ul>
                <li>One per part of the app, in the columns of ports and adapters, with a row for each driven port, sorted by name.</li>
                <li>A bubble's area is its lines of code, not counting blank lines or comments.</li>
                <li>The ring shows Stryker's mutants: caught, survived, and not reached by any spec. A faded ring is older than the code.</li>
                <li>Hover a bubble for all its numbers and to pick out its links. Turn layers off to see what each adds.</li>
            </ul>
            <p class="help">Everything happens in this browser: nothing is uploaded, and there's no sign-in. Visits are counted, with no cookies, by <a href="https://www.goatcounter.com" target="_blank" rel="noopener">GoatCounter</a>. The code is mapped by Motif's naming conventions, so a repo that strays from them is drawn badly.</p>
        </HelpDialog>
    }

    <ToastList Toaster="Toaster" />
</div>
}
